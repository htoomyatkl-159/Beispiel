# Local-only default. Open http://localhost:4000/api/v1/health/live
HOST=127.0.0.1
PORT=4000
NODE_ENV=development

# SQLite path is relative to this API root (shared by CLI and runtime).
DATABASE_URL=file:./prisma/dev.db

# Authentication configuration (Stage 1 only; routes are added in later M07 stages).
# Development uses a local placeholder when JWT_SECRET is omitted. Never use that default in production.
# For production, generate at least 32 random bytes, for example:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=beispiel-api
JWT_AUDIENCE=beispiel-web
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_COOKIE_NAME=beispiel_access
ALLOWED_FRONTEND_ORIGIN=http://127.0.0.1:5173
AUTH_COOKIE_SAMESITE=lax
# Cookie policy is intentionally fixed by the API: HttpOnly=true, SameSite=Lax,
# and Secure=true automatically in production (HTTPS). For separate Vercel and
# Railway domains, use AUTH_COOKIE_SAMESITE=none with HTTPS and the origin check.

# Variables already set in PowerShell take precedence over .env.
RECOMMENDER_BASE_URL=http://127.0.0.1:8000
RECOMMENDER_TIMEOUT_MS=2500
